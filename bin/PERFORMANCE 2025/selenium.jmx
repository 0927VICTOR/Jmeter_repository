        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="false">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">C:/Users/victor.ibarguen/Desktop/apache-jmeter-5.6.2/selenium.jmx</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.protocol.http.sampler.HTTPSamplerProxy;
import org.apache.jmeter.protocol.http.control.HeaderManager;
import org.apache.jmeter.samplers.SampleResult;
import org.apache.jmeter.protocol.http.util.HTTPConstants;
import org.apache.jmeter.threads.JMeterVariables;

// Crear la solicitud HTTP
HTTPSamplerProxy httpSampler = new HTTPSamplerProxy();
httpSampler.setDomain(&quot;your-api-domain.com&quot;);
httpSampler.setPort(80); // Cambia el puerto si es necesario, por ejemplo, 443 para HTTPS
httpSampler.setPath(&quot;/login&quot;);
httpSampler.setMethod(HTTPConstants.POST);

// Crear el cuerpo de la solicitud
String loginPayload = &quot;{ \&quot;username\&quot;: \&quot;your-username\&quot;, \&quot;password\&quot;: \&quot;your-password\&quot; }&quot;;
httpSampler.addNonEncodedArgument(&quot;&quot;, loginPayload, &quot;&quot;);
httpSampler.setPostBodyRaw(true);

// Establecer los encabezados (si es necesario)
HeaderManager headerManager = new HeaderManager();
headerManager.add(&quot;Content-Type&quot;, &quot;application/json&quot;);
httpSampler.setHeaderManager(headerManager);

// Ejecutar la solicitud y obtener el resultado
SampleResult result = httpSampler.sample();

// Verificar si la solicitud fue exitosa
if (result.isSuccessful()) {
    // Obtener el cuerpo de la respuesta
    String response = result.getResponseDataAsString();
    
    // Parsear el token de autenticación de la respuesta (asumiendo que está en JSON)
    // Aquí se asume que la respuesta tiene una estructura JSON como {&quot;token&quot;: &quot;your-auth-token&quot;}
    import groovy.json.JsonSlurper;
    JsonSlurper jsonSlurper = new JsonSlurper();
    Map parsedResponse = jsonSlurper.parseText(response);
    String authToken = parsedResponse.get(&quot;token&quot;);
    
    // Guardar el token en las variables de JMeter
    JMeterVariables vars = ctx.getVariables();
    vars.put(&quot;authToken&quot;, authToken);
    
    // Establecer el mensaje de respuesta y el estado del sampler
    SampleResult.setResponseMessage(&quot;Login successful.&quot;);
    SampleResult.setResponseData(response, &quot;UTF-8&quot;);
    SampleResult.setSuccessful(true);
} else {
    // Establecer el mensaje de respuesta y el estado del sampler en caso de error
    SampleResult.setResponseMessage(&quot;Login failed: &quot; + result.getResponseMessage());
    SampleResult.setResponseData(result.getResponseData(), &quot;UTF-8&quot;);
    SampleResult.setSuccessful(false);
}
</stringProp>
          <stringProp name="scriptLanguage">java</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="jp@gc - WebDriver Sampler" enabled="false">
          <stringProp name="WebDriverSampler.script"></stringProp>
          <stringProp name="WebDriverSampler.parameters"></stringProp>
          <stringProp name="WebDriverSampler.language">beanshell</stringProp>
        </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
        <hashTree/>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="jp@gc - WebDriver Sampler" enabled="false">
          <stringProp name="WebDriverSampler.script"> 

// Required to start counting time which will get reported at the end of this code.
WDS.sampleResult.sampleStart();

def service = new ChromeDriverService.Builder().build();
service.start();
DesiredCapabilities capabilities = new DesiredCapabilities();

def  driver = new RemoteWebDriver(service.getUrl(), DesiredCapabilities.chrome());

WDS.browser.get(&quot;https://myTestedUrl.com&quot;);


// Login
WDS.browser.findElementBy(org.openqa.selenium.By.id(&apos;username&apos;)).sendKeys(&apos;myusername&apos;);
//driver.findElementById(&apos;password&apos;).sendKeys(&apos;mypassword&apos;);
Thread.sleep(500);
//river.findElementById(&apos;submit&apos;).click();
Thread.sleep(1500);

// Css selector
//driver.findElement(By.cssSelector(&quot;button&quot;)).click();
Thread.sleep(1550);

// End the test sampler, capturing length of time for the test.
WDS.sampleResult.sampleEnd();</stringProp>
          <stringProp name="WebDriverSampler.parameters"></stringProp>
          <stringProp name="WebDriverSampler.language">groovy</stringProp>
        </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
