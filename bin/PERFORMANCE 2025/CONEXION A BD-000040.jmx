        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC " enabled="true">
          <stringProp name="dataSource">VAR</stringProp>
          <stringProp name="query">SELECT
  DISTINCT MasterGuide.SerializationType,
  Pieces.Consecutivo,
  Pieces.IdFinca,
  DispatchOrder.IdOrdenDespacho,
  MasterGuide.IdGuiaMaestra,
  DispatchOrder.AwbId ,MasterGuide.Numero AS MasterGuide,
  ChildGuide.Numero AS ChildGuide,
  Pieces.FechaCreacionUTC
FROM
  SI_GS_PIEZAS AS Pieces
  INNER JOIN SI_GS_DESPACHO_DEV AS DispatchDev ON Pieces.IdOrdenDespacho = DispatchDev.idOrdenDespacho
  AND Pieces.IdLineaDespacho = DispatchDev.Id
  INNER JOIN SI_GS_ORDEN_DESPACHO AS DispatchOrder ON DispatchDev.IdOrdenDespacho = DispatchOrder.IdOrdenDespacho
  INNER JOIN SI_GS_GUIAS_MAESTRAS AS MasterGuide ON DispatchOrder.IdGuiaMaestra = MasterGuide.IdGuiaMaestra
  INNER JOIN SI_GS_GUIAS_HIJAS AS ChildGuide ON MasterGuide.IdGuiaMaestra = ChildGuide.IdGuiaMaestra
  AND DispatchDev.guia = ChildGuide.Numero
WHERE
  Pieces.Consecutivo = &apos;JP9XIY&apos;

</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="variableNames"></stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request" enabled="false">
          <stringProp name="dataSource">VAR</stringProp>
          <stringProp name="query">select * from tblOrderLinesBoxes WHERE LineId = 762586
select * from tblOrderLinesBoxHardgoods WHERE OrderLineBoxId = 112555
select top 10 * from tblBoxHardgoodsPlanning WHERE LineId = 762586</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="variableNames"></stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request2" enabled="false">
          <stringProp name="dataSource">VAR</stringProp>
          <stringProp name="query">SELECT Request.Reference,
       RequestLines.StandingOrderRequestLineId,
       RequestLines.ItemNumber,
       COUNT(LineBoxes.BoxCode) AS CountAssignedBoxes
FROM tblStandingOrderRequestLines AS RequestLines
    INNER JOIN tblStandingOrderRequest AS Request ON RequestLines.StandingOrderRequestId = Request.StandingOrderRequestId
    LEFT JOIN tblSORLinesBoxes AS LineBoxes ON RequestLines.StandingOrderRequestLineId = LineBoxes.RequestLineId
WHERE LineBoxes.RequestLineId IS NOT NULL
      AND RequestLines.StandingOrderRequestLineId IN (13021, 13162)
GROUP BY Request.Reference,
         RequestLines.ItemNumber,
         RequestLines.StandingOrderRequestLineId
</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="variableNames"></stringProp>
        </JDBCSampler>
