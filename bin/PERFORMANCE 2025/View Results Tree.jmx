WDS.Browser.findElement(org.openqa.selenium.By.id(&quot;txtPassword&quot;)).sendKeys(&quot;Vibarguen&quot;);
WDS.Browser.findElement(org.openqa.selenium.By.id(&quot;txtPassword&quot;)).sendKeys(Keys.ENTER);

//java.lang.Thread.sleep(10000);
