//WDS.Browser.findElement(org.openqa.selenium.By.cssSelector(&quot;li:nth-child(16) &gt; .div-child &gt; .link &gt; .ellipsis&quot;)).click();
//java.lang.Thread.sleep(5000);
//WDS.Browser.findElement(By.cssSelector(&quot;#sub15_Planos_de_Siembra_22 &gt; li:nth-child(1) .text&quot;)).click();
