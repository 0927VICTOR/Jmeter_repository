          <stringProp name="WebDriverSampler.script">// Importar las bibliotecas necesarias
import org.openqa.selenium.By
import org.openqa.selenium.Dimension
import org.openqa.selenium.Keys
import org.openqa.selenium.WebDriver
import org.openqa.selenium.chrome.ChromeDriver
 


// Establecer las propiedades del navegador (si es necesario)
// System.setProperty(&quot;webdriver.chrome.driver&quot;, &quot;/path/to/chromedriver&quot;) // Configura el path si es necesario

// Iniciar el navegador y navegar a la URL
WDS.Browser.get(&quot;https://betamg.ghtcorp.biz&quot;);
//WDS.Browser.manage().window().setSize(new Dimension(1014, 577))

// Interacciones con la página
//WDS.Browser.findElement(org.openqa.selenium.By.cssSelector(&quot;.d-flex:nth-child(3)&quot;)).click()
