&#xd;
        function isValidDate(date) {&#xd;
            if (date != null &amp;&amp; date.value != &quot;&quot;) {&#xd;
                var arrDate = date.value.split(&quot;/&quot;);&#xd;
&#xd;
                if ((isNaN(arrDate[1])) || (arrDate[1] == &quot;&quot;)) {&#xd;
                    return false;&#xd;
                }&#xd;
                else {&#xd;
                    var day = parseInt(arrDate[1], 10);&#xd;
                }&#xd;
&#xd;
                if ((isNaN(arrDate[0])) || (arrDate[0] == &quot;&quot;)) {&#xd;
                    return false;&#xd;
                }&#xd;
                else {&#xd;
                    var month = parseInt(arrDate[0], 10);&#xd;
                }&#xd;
                if ((isNaN(arrDate[2])) || (arrDate[2] == &quot;&quot;)) {&#xd;
                    return false;&#xd;
                }&#xd;
                else {&#xd;
                    var year = parseInt(arrDate[2]);&#xd;
                }&#xd;
                if ((year &lt;= 999) || (year &gt;= 10000)) {&#xd;
                    return false;&#xd;
                }&#xd;
&#xd;
                switch (month) {&#xd;
                    case 1:&#xd;
                    case 3:&#xd;
                    case 5:&#xd;
                    case 7:&#xd;
                    case 8:&#xd;
                    case 10:&#xd;
                    case 12:&#xd;
                        numDays = 31;&#xd;
                        break;&#xd;
                    case 4: case 6: case 9: case 11:&#xd;
                        numDays = 30;&#xd;
                        break;&#xd;
                    case 2:&#xd;
                        if (isLeapYear(year)) {&#xd;
                            numDays = 29;&#xd;
                        }&#xd;
                        else {&#xd;
                            numDays = 28;&#xd;
                        }&#xd;
                        break;&#xd;
                    default:&#xd;
                        return false;&#xd;
                }&#xd;
                if (day &gt; numDays || day == 0) {&#xd;
                    return false;&#xd;
                }&#xd;
                return true;&#xd;
            }&#xd;
        }&#xd;
&#xd;
        function isLeapYear(year) {&#xd;
            if ((year % 100 != 0) &amp;&amp; ((year % 4 == 0) || (year % 400 == 0))) {&#xd;
                return true;&#xd;
            }&#xd;
            else {&#xd;
                return false;&#xd;
            }&#xd;
        }&#xd;
&#xd;
        function searchAssignmentBoncheo() {&#xd;
            if (isValidDate(myform.txtDateFrom) == false) {&#xd;
                alert(&quot;Error: &apos;Fecha Inicial&apos; Invalida. Por favor ingrese una fecha valida.&quot;);&#xd;
                myform.txtDateFrom.value = &quot;&quot;;&#xd;
                return;&#xd;
            }&#xd;
            if (isValidDate(myform.txtDateTo) == false) {&#xd;
                alert(&quot;Error: &apos;Fecha Final&apos; Invalida. Por favor ingrese una fecha valida.&quot;);&#xd;
                myform.txtDateFrom.value = &quot;&quot;;&#xd;
                return;&#xd;
            }&#xd;
            if (myform.txtDateFrom.value == &quot;&quot; || myform.txtDateTo.value == &quot;&quot;) {&#xd;
&#xd;
                alert(&quot;Error: Fecha invalida. Por favor ingrese una fecha valida.&quot;);&#xd;
                return;&#xd;
            }&#xd;
&#xd;
            if (validateDates() == false) {&#xd;
                alert(&quot;Fecha Final debe ser mayor o igual que Fecha Inicial&quot;);&#xd;
                myform.txtDateFrom.value = &quot;&quot;;&#xd;
                return;&#xd;
            }&#xd;
&#xd;
            myform.txtAction.value = &quot;Search&quot;;&#xd;
            document.all(&quot;divProgress&quot;).style.display = &quot;block&quot;;&#xd;
            myform.submit();&#xd;
        }&#xd;
&#xd;
        function changeDate() {&#xd;
&#xd;
            var date = myform.txtDateTo;&#xd;
&#xd;
&#xd;
            if (myform.txtDateTo.value == &quot;&quot;) {&#xd;
                var objToday = new Date();&#xd;
                myform.txtDateTo.value = (objToday.getMonth() + 1) + &quot;/&quot; + objToday.getDate() + &quot;/&quot; + objToday.getFullYear();&#xd;
            }&#xd;
&#xd;
            if (isValidDate(date) == false) {&#xd;
                var objToday = new Date();&#xd;
                myform.txtDateTo.value = (objToday.getMonth() + 1) + &quot;/&quot; + objToday.getDate() + &quot;/&quot; + objToday.getFullYear();&#xd;
            }&#xd;
&#xd;
        }&#xd;
&#xd;
        function validateDates() {&#xd;
            if ((myform.txtDateTo.value != &quot;&quot;) &amp;&amp; (myform.txtDateFrom.value != &quot;&quot;)) {&#xd;
                dateTo = new Date(myform.txtDateTo.value);&#xd;
                dateFrom = new Date(myform.txtDateFrom.value);&#xd;
&#xd;
                if (dateFrom &gt; dateTo) {&#xd;
                    return false;&#xd;
                }&#xd;
                else {&#xd;
                    return true;&#xd;
                }&#xd;
            }&#xd;
            else {&#xd;
                return true;&#xd;
            }&#xd;
        }&#xd;
&#xd;
        function window_onLoad() {&#xd;
            $(&quot;#txtDateTo&quot;).datepicker();&#xd;
